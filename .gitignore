# --- data and artifacts: never committed, except the directory markers ---
# The `!.../**/` lines re-admit directories so git keeps descending and can see the
# .gitkeep files; without them a `dir/**` rule prunes the whole subtree unread.
/data/**
!/data/**/
!/data/**/.gitkeep
/artifacts/**
!/artifacts/**/
!/artifacts/**/.gitkeep

# --- model weights and checkpoints ---
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.gguf

# --- secrets ---
.env
.env.*
!.env.example
*.pem
credentials.json

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# --- hydra stray outputs (real runs go to artifacts/runs) ---
outputs/
multirun/

# --- W&B local run store. The trainer falls back to offline mode when no API key is
# present (Phase 7), so a run always writes here; the record that matters is
# artifacts/runs/<...>/run_context.json, which is invariant 5's artifact.
wandb/

# --- editors / os ---
.idea/
.vscode/
.DS_Store
